# Umgebung der Runner-Slots auf celsius, als /etc/github-runner/github-runner.env
# (root:root, 0600). Leere Werte gelten als nicht gesetzt, dann greift die Vorgabe.
# Hier stehen keine Secrets: Das PAT liegt in der Datei aus GH_RUNNER_TOKEN_FILE.

# Zustandsverzeichnis mit Schalter `pause`, Sperre `lock` und slots/<slot>.state.
# Vorgabe: /var/lib/github-runner
GH_RUNNER_STATE_DIR=

# Datei mit dem fine-grained PAT (nur root lesbar). Vorgabe: /etc/github-runner/token
GH_RUNNER_TOKEN_FILE=

# Besitzer der Repos. Vorgabe: Schorschofwill
GH_RUNNER_OWNER=

# Nutzer mit dem rootless Docker, unter dem der Runner läuft. Vorgabe: ghrunner
GH_RUNNER_USER=

# Home dieses Nutzers. Vorgabe: /home/<GH_RUNNER_USER>
GH_RUNNER_HOME=

# Pflicht: entpackte, gepinnte Runner-Distribution. Der Verzeichnisname ist die
# Version, z. B. /opt/github-runner/dist/<version>.
GH_RUNNER_DIST=

# Pflicht: Socket des rootless Docker von ghrunner, unix:///run/user/<uid>/docker.sock
GH_RUNNER_DOCKER_HOST=
